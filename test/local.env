# Local development and tests only, against the local Keycloak from centralauth
# (centralauth/keycloak/local.env). Never use these values on a server.
HUB_ISSUER=http://localhost:8180/realms/modula
HUB_CLIENT_ID=kpi-tracker
HUB_CLIENT_SECRET=local-kpi-tracker
HUB_REDIRECT_URI=http://localhost:3003/auth/hub
HUB_POST_LOGOUT_URI=http://localhost:3003/login
HUB_URL=http://localhost:3100

# The app's own session secret and local password account (spec D4) for dev:local and e2e.
AUTH_SECRET=local-kpi-auth-secret-local-kpi-auth-secret
AUTH_EMAIL=local-admin@test.local
AUTH_PASSWORD=local-password

# Keycloak master admin, used only by test/helpers/kc.ts to create test users and grants.
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=local-admin
