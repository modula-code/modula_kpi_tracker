# Copy to .env and fill in. Never commit .env.

# --- Odoo (read-only data source) -------------------------------------------
ODOO_URL=https://odoo.example.com
ODOO_DB=
ODOO_USERNAME=
ODOO_PASSWORD=

# --- Local password login (always "admin"; stays alongside Google sign-in) -----
AUTH_EMAIL=
AUTH_PASSWORD=
# Signs kpi_session and, via HKDF (info "sso-cookie"), encrypts kpi_sso. `openssl rand -hex 32`
AUTH_SECRET=

# --- "Continue with Google" through Keycloak (realm modula, client kpi-tracker) -
# All six must be set, otherwise the button says "not configured".
HUB_ISSUER=https://auth.services.modula.in/realms/modula
HUB_CLIENT_ID=kpi-tracker
# Keycloak admin console → Clients → kpi-tracker → Credentials
HUB_CLIENT_SECRET=
# Must match the client's redirect URI and post-logout redirect URI in Keycloak exactly.
HUB_REDIRECT_URI=https://kpi.example.com/auth/hub
HUB_POST_LOGOUT_URI=https://kpi.example.com/login
# Access Hub (users without a kpi-tracker role are sent to $HUB_URL/no-access?app=kpi-tracker)
HUB_URL=https://hub.example.com
